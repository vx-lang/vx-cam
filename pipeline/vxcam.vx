//===- vxcam.vx - The vx-cam frame pipeline ---------------------*- Vx -*-===//
//
// The compute stages of vx-cam: background blur with auto-framing. Every stage
// is a `pub fn`, so the host shell calls it through the C ABI (see vxcam.h).
// The host owns every buffer and passes each one as a tensor.
//
// Every stage is GPU kernels. vxc also compiles a CPU copy of each kernel, and
// `vx_metal_set_enabled` picks one for the calling thread, so each stage runs
// on either device from one source. Until the segmentation model exists,
// `vxcam_segment` finds the person by background subtraction against a static
// background.
//
// Buffers:
//   frame   BGRA8, w x h pixels, `stride` bytes per row (from the camera or video)
//   small   RGB f32 in 0..1, sw x sh pixels, sw = w / scale and sh = h / scale
//   mask    f32 in 0..1, sw x sh, 1 where the person is
//   crop    [1, 4] f32: x0, y0, width, height of the output window, in frame pixels
//
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// How the kernels are written. A clamp of v to [lo, hi] is "lo, or v if v > lo;
// then hi if that is above hi". A max of a and b is "a if a > b, else b". An
// abs is "0 - v if v < 0". Each is written out where it is used: vxc's Metal
// generator does not inline calls to helper functions yet.
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// Stage 1: preprocess. Average each scale x scale block of the frame into one
// pixel of `small`, and convert BGRA8 to RGB f32.
//
// A GPU kernel, one lane per pixel of `small`. The frame is `[h, stride]` bytes:
// Vx ignores the row stride of a tensor from C, so the padding at the end of
// each row is part of the row.
//===----------------------------------------------------------------------===//

// `inv` is 1 / (scale * scale * 255).
fn preprocess_kernel(small : &mut Tensor<f32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, sw : i32, sh : i32, scale : i32,
inv : f32) -> void {
  spawn on(Topology::Device) {
    for sy in 0..sh across blocks {
      for sx in 0..sw across lanes(256) {
        let mut r : f32 = 0.0;
        let mut g : f32 = 0.0;
        let mut b : f32 = 0.0;
        for dy in 0..scale {
          let y = sy * scale + dy;
          for dx in 0..scale {
            let p = (sx * scale + dx) * 4;
            b = b + frame[y][p] as f32;
            g = g + frame[y][p + 1] as f32;
            r = r + frame[y][p + 2] as f32;
          }
        }
        small[sy][sx * 3] = r * inv;
        small[sy][sx * 3 + 1] = g * inv;
        small[sy][sx * 3 + 2] = b * inv;
      }
    }
  }
  return;
}

pub fn vxcam_preprocess(small : &mut Tensor<f32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, sw : i32, sh : i32, scale : i32) -> void {
  let inv : f32 = 1.0 / ((scale * scale) as f32 * 255.0);
  preprocess_kernel(small, frame, sw, sh, scale, inv);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 2: segment. A stand-in for the segmentation model: a pixel belongs to
// the person when it differs from a running model of the background. The model
// learns only where the mask says "background", so a person who stands still
// is not absorbed at once. Frame 0 copies the background model from the frame.
//===----------------------------------------------------------------------===//

// A GPU kernel, one lane per pixel. `small` and `background` are `[sh, 3 * sw]`,
// `mask` is `[sh, sw]`. `first` is 1 on frame 0. The mask is
// smoothstep(0.06, 0.14, d), where d is the largest difference of the three
// channels from the background model.
fn segment_kernel(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
background : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, first : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let r = small[y][x * 3];
        let g = small[y][x * 3 + 1];
        let b = small[y][x * 3 + 2];
        let mut br = background[y][x * 3];
        let mut bg = background[y][x * 3 + 1];
        let mut bb = background[y][x * 3 + 2];
        if first == 1 {
          br = r;
          bg = g;
          bb = b;
        }
        let mut dr = r - br;
        if dr < 0.0 {
          dr = 0.0 - dr;
        }
        let mut dg = g - bg;
        if dg < 0.0 {
          dg = 0.0 - dg;
        }
        let mut db = b - bb;
        if db < 0.0 {
          db = 0.0 - db;
        }
        let mut d = db;
        if dg > db {
          d = dg;
        }
        if dr > d {
          d = dr;
        }
        let ramp = (d - 0.06) / (0.14 - 0.06);
        let mut t : f32 = 0.0;
        if ramp > 0.0 {
          t = ramp;
        }
        if t > 1.0 {
          t = 1.0;
        }
        let m = t * t * (3.0 - 2.0 * t);
        mask[y][x] = m;
        let rate : f32 = 0.02 * (1.0 - m);
        background[y][x * 3] = br + rate * (r - br);
        background[y][x * 3 + 1] = bg + rate * (g - bg);
        background[y][x * 3 + 2] = bb + rate * (b - bb);
      }
    }
  }
  return;
}

pub fn vxcam_segment(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
background : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, frame_index : i32) -> void {
  let mut first : i32 = 0;
  if frame_index == 0 {
    first = 1;
  }
  segment_kernel(mask, background, small, sw, sh, first);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 3: smooth. The branchy, stateful work that belongs on the CPU.
//   - Blend the new mask into the mask kept from earlier frames, so edges do
//     not flicker, then soften it with a small box filter.
//   - Find the person's bounding box and move the crop window toward a frame
//     around it. Small moves are ignored, so the window does not jitter.
// `history` and `crop` keep their values from one frame to the next. After the
// stage, `history` is the softened mask that composite reads.
//
// Four GPU kernels, so the stage can move to the GPU like the others: the blend
// and the box filter along rows, the box filter along columns, each row's part
// of the bounding box, and one GPU thread for the rest. Host code cannot read
// a tensor in HBM (E6003), even on unified memory, so the serial rest is a
// kernel too. Each image is `[sh, sw]`, and `stats` is `[sh, 3]`.
//===----------------------------------------------------------------------===//

// scratch = the box filter of radius 2 along each row of the blend of `mask`
// into `history`. On frame 0 (`first` is 1) the blend is the mask itself.
fn smooth_rows(scratch : &mut Tensor<f32, [?, ?], Memory::HBM>,
history : &Tensor<f32, [?, ?], Memory::HBM>, mask : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, first : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..5 {
          let mut xx = x + d - 2;
          if xx < 0 {
            xx = 0;
          }
          if xx > sw - 1 {
            xx = sw - 1;
          }
          let old = history[y][xx];
          let new = mask[y][xx];
          let mut blend = old + 0.5 * (new - old);
          if first == 1 {
            blend = new;
          }
          // Where the person has left, the blend halves each frame and would
          // reach the subnormal floats. The GPU flushes those to zero and the
          // CPU does not, so the two devices would differ. Zero it well before.
          if blend < 0.000001 {
            blend = 0.0;
          }
          acc = acc + blend;
        }
        scratch[y][x] = acc / 5.0;
      }
    }
  }
  return;
}

// history = the box filter of radius 2 along each column of scratch.
fn smooth_cols(history : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..5 {
          let mut yy = y + d - 2;
          if yy < 0 {
            yy = 0;
          }
          if yy > sh - 1 {
            yy = sh - 1;
          }
          acc = acc + scratch[yy][x];
        }
        history[y][x] = acc / 5.0;
      }
    }
  }
  return;
}

// For each row y, one lane finds the first and the last x where the person is
// (history > 0.5) and how many such pixels there are: stats[y] = [first, last,
// count], or [sw, -1, 0] for a row without the person.
fn row_stats(stats : &mut Tensor<i32, [?, ?], Memory::HBM>,
history : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(sh + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let y = g * 256 + l;
        if y < sh {
          let mut lo = sw;
          let mut hi : i32 = 0 - 1;
          let mut n : i32 = 0;
          for x in 0..sw {
            if history[y][x] > 0.5 {
              if x < lo {
                lo = x;
              }
              hi = x;
              n = n + 1;
            }
          }
          stats[y][0] = lo;
          stats[y][1] = hi;
          stats[y][2] = n;
        }
      }
    }
  }
  return;
}

// The rest of the stage, as one GPU thread (a region with no `across` loop):
// reduce the rows to one bounding box, then move the crop window toward a frame
// around it. This is serial work, slow on a GPU thread, which the overlay shows.
// `crop` is `[1, 4]`.
fn frame_crop(crop : &mut Tensor<f32, [?, ?], Memory::HBM>,
stats : &Tensor<i32, [?, ?], Memory::HBM>, sw : i32, sh : i32, w : i32, h : i32,
first : i32) -> void {
  spawn on(Topology::Device) {
    // Bounding box of the person, from the rows.
    let mut min_x = sw;
    let mut min_y = sh;
    let mut max_x : i32 = 0 - 1;
    let mut max_y : i32 = 0 - 1;
    let mut count : i32 = 0;
    for y in 0..sh {
      let n = stats[y][2];
      if n > 0 {
        if stats[y][0] < min_x {
          min_x = stats[y][0];
        }
        if stats[y][1] > max_x {
          max_x = stats[y][1];
        }
        if y < min_y {
          min_y = y;
        }
        max_y = y;
        count = count + n;
      }
    }

    // The window to move toward: the whole frame when nobody is there, or the
    // person's box with some room around it, at the frame's aspect ratio.
    let fw = w as f32;
    let fh = h as f32;
    let mut th = fh;
    let mut tx : f32 = 0.0;
    let mut ty : f32 = 0.0;
    if count * 500 > sw * sh {
      let sx = fw / (sw as f32);
      let sy = fh / (sh as f32);
      let bx0 = (min_x as f32) * sx;
      let by0 = (min_y as f32) * sy;
      let bw = ((max_x - min_x + 1) as f32) * sx;
      let bh = ((max_y - min_y + 1) as f32) * sy;
      // th = clamp(max(bh * 1.5, bw * 1.5 * fh / fw), fh * 0.45, fh)
      let tall = bh * 1.5;
      let wide = bw * 1.5 * fh / fw;
      let mut big = wide;
      if tall > wide {
        big = tall;
      }
      th = fh * 0.45;
      if big > th {
        th = big;
      }
      if th > fh {
        th = fh;
      }
      let tw = th * fw / fh;
      // tx = clamp(bx0 + bw * 0.5 - tw * 0.5, 0, fw - tw), and ty the same way.
      let ax = bx0 + bw * 0.5 - tw * 0.5;
      if ax > 0.0 {
        tx = ax;
      }
      if tx > fw - tw {
        tx = fw - tw;
      }
      let ay = by0 + bh * 0.4 - th * 0.4;
      if ay > 0.0 {
        ty = ay;
      }
      if ty > fh - th {
        ty = fh - th;
      }
    }

    let mut c0 = crop[0][0];
    let mut c1 = crop[0][1];
    let mut c2 = crop[0][2];
    let mut c3 = crop[0][3];
    if first == 1 {
      c0 = 0.0;
      c1 = 0.0;
      c2 = fw;
      c3 = fh;
    }
    // Ignore moves under 3% of the frame. Otherwise ease toward the target.
    let mut dx = tx - c0;
    if dx < 0.0 {
      dx = 0.0 - dx;
    }
    let mut dy = ty - c1;
    if dy < 0.0 {
      dy = 0.0 - dy;
    }
    let mut dh = th - c3;
    if dh < 0.0 {
      dh = 0.0 - dh;
    }
    if dx + dy + dh > 0.03 * fh {
      let k : f32 = 0.06;
      c0 = c0 + k * (tx - c0);
      c1 = c1 + k * (ty - c1);
      c3 = c3 + k * (th - c3);
      c2 = c3 * fw / fh;
    }
    crop[0][0] = c0;
    crop[0][1] = c1;
    crop[0][2] = c2;
    crop[0][3] = c3;
  }
  return;
}

pub fn vxcam_smooth(history : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &mut Tensor<f32, [?, ?], Memory::HBM>, mask : &Tensor<f32, [?, ?], Memory::HBM>,
stats : &mut Tensor<i32, [?, ?], Memory::HBM>, crop : &mut Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, w : i32, h : i32, frame_index : i32) -> void {
  let mut first : i32 = 0;
  if frame_index == 0 {
    first = 1;
  }
  smooth_rows(scratch, history, mask, sw, sh, first);
  smooth_cols(history, scratch, sw, sh);
  row_stats(stats, history, sw, sh);
  frame_crop(crop, stats, sw, sh, w, h, first);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 4: blur. Blur the small image with two box passes per direction, which
// is close to a Gaussian. The composite stage scales it up to the frame, so a
// radius of r small pixels is a radius of r * scale frame pixels.
//
// The passes are GPU kernels. `vx_metal_set_enabled(0)` runs the CPU copy of
// the same kernels on the same memory, so the CPU and the GPU run one source.
// The images are interleaved RGB: `rows` x `cols` floats, cols = 3 * width.
//===----------------------------------------------------------------------===//

// One box pass of radius `r` along each row. `n` is 2 * r + 1 as a float.
fn blur_rows(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, cols : i32, r : i32, n : f32) -> void {
  spawn on(Topology::Device) {
    for y in 0..rows across blocks {
      for i in 0..cols across lanes(256) {
        let x = i / 3;
        let c = i - x * 3;
        let last = cols / 3 - 1;
        let mut acc : f32 = 0.0;
        for d in 0..2 * r + 1 {
          let mut xx = x + d - r;
          if xx < 0 {
            xx = 0;
          }
          if xx > last {
            xx = last;
          }
          acc = acc + src[y][xx * 3 + c];
        }
        dst[y][i] = acc / n;
      }
    }
  }
  return;
}

// One box pass of radius `r` along each column. `n` is 2 * r + 1 as a float.
fn blur_cols(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, cols : i32, r : i32, n : f32) -> void {
  spawn on(Topology::Device) {
    for i in 0..cols across blocks {
      for y in 0..rows across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..2 * r + 1 {
          let mut yy = y + d - r;
          if yy < 0 {
            yy = 0;
          }
          if yy > rows - 1 {
            yy = rows - 1;
          }
          acc = acc + src[yy][i];
        }
        dst[y][i] = acc / n;
      }
    }
  }
  return;
}

pub fn vxcam_blur(blurred : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
rows : i32, cols : i32, radius : i32) -> void {
  let n = (2 * radius + 1) as f32;
  blur_rows(scratch, small, rows, cols, radius, n);
  blur_cols(blurred, scratch, rows, cols, radius, n);
  blur_rows(scratch, blurred, rows, cols, radius, n);
  blur_cols(blurred, scratch, rows, cols, radius, n);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 5: composite. For each output pixel, find where it comes from inside the
// crop window, then mix the sharp frame and the blurred background by the mask.
// `mode` 0 is the normal output, 1 shows the mask, 2 turns the blur off.
//
// A GPU kernel, one lane per output pixel. `frame` is `[h, stride]` bytes as in
// preprocess, `out` is `[h, w]` BGRA pixels, `blurred` is `[sh, 3 * sw]` and
// `mask` is `[sh, sw]`.
//===----------------------------------------------------------------------===//

// `crop` is `[1, 4]`: x0, y0, width and height of the window, in frame pixels.
// `inv_scale` is 1 / scale, from frame pixels to small pixels.
//
// Each lane writes its pixel as one u32 (B, G, R, A from the low byte up), so
// the race checker sees that no two lanes write the same element. Each bilinear
// mix is a + fx * (b - a) along the row, then the same down the column.
fn composite_kernel(out : &mut Tensor<u32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, blurred : &Tensor<f32, [?, ?], Memory::HBM>,
mask : &Tensor<f32, [?, ?], Memory::HBM>, crop : &Tensor<f32, [?, ?], Memory::HBM>,
inv_scale : f32, w : i32, h : i32, sw : i32, sh : i32, mode : i32) -> void {
  spawn on(Topology::Device) {
    for oy in 0..h across blocks {
      for ox in 0..w across lanes(256) {
        // The window's corner, and the scale from output pixels to frame pixels.
        let x0 = crop[0][0];
        let y0 = crop[0][1];
        let kx = crop[0][2] / (w as f32);
        let ky = crop[0][3] / (h as f32);
        // Where this pixel comes from: sy, sx in the frame, v, u in the small images.
        let ty = y0 + ((oy as f32) + 0.5) * ky - 0.5;
        let mut sy : f32 = 0.0;
        if ty > 0.0 {
          sy = ty;
        }
        if sy > (h - 1) as f32 {
          sy = (h - 1) as f32;
        }
        let iy0 = sy as i32;
        let mut iy1 = iy0 + 1;
        if iy1 > h - 1 {
          iy1 = h - 1;
        }
        let fy = sy - iy0 as f32;
        let tv = (sy + 0.5) * inv_scale - 0.5;
        let mut v : f32 = 0.0;
        if tv > 0.0 {
          v = tv;
        }
        if v > (sh - 1) as f32 {
          v = (sh - 1) as f32;
        }
        let vy0 = v as i32;
        let mut vy1 = vy0 + 1;
        if vy1 > sh - 1 {
          vy1 = sh - 1;
        }
        let gy = v - vy0 as f32;
        let tx = x0 + ((ox as f32) + 0.5) * kx - 0.5;
        let mut sx : f32 = 0.0;
        if tx > 0.0 {
          sx = tx;
        }
        if sx > (w - 1) as f32 {
          sx = (w - 1) as f32;
        }
        let ix0 = sx as i32;
        let mut ix1 = ix0 + 1;
        if ix1 > w - 1 {
          ix1 = w - 1;
        }
        let fx = sx - ix0 as f32;
        let tu = (sx + 0.5) * inv_scale - 0.5;
        let mut u : f32 = 0.0;
        if tu > 0.0 {
          u = tu;
        }
        if u > (sw - 1) as f32 {
          u = (sw - 1) as f32;
        }
        let ux0 = u as i32;
        let mut ux1 = ux0 + 1;
        if ux1 > sw - 1 {
          ux1 = sw - 1;
        }
        let gx = u - ux0 as f32;
        let mt = mask[vy0][ux0] + gx * (mask[vy0][ux1] - mask[vy0][ux0]);
        let mb = mask[vy1][ux0] + gx * (mask[vy1][ux1] - mask[vy1][ux0]);
        let m = mt + gy * (mb - mt);
        let mut pixel : u32 = 4278190080; // A = 255
        for c in 0..3 {
          // BGRA in the frame and in `out`, RGB in `blurred`.
          let a00 = frame[iy0][ix0 * 4 + c] as f32;
          let a01 = frame[iy0][ix1 * 4 + c] as f32;
          let a10 = frame[iy1][ix0 * 4 + c] as f32;
          let a11 = frame[iy1][ix1 * 4 + c] as f32;
          let st = a00 + fx * (a01 - a00);
          let sb = a10 + fx * (a11 - a10);
          let sharp = st + fy * (sb - st);
          let k = 2 - c;
          let b00 = blurred[vy0][ux0 * 3 + k];
          let b01 = blurred[vy0][ux1 * 3 + k];
          let b10 = blurred[vy1][ux0 * 3 + k];
          let b11 = blurred[vy1][ux1 * 3 + k];
          let bt = b00 + gx * (b01 - b00);
          let bb = b10 + gx * (b11 - b10);
          let soft = 255.0 * (bt + gy * (bb - bt));
          let mut value = sharp;
          if mode == 0 {
            value = soft + m * (sharp - soft);
          }
          if mode == 1 {
            value = 0.25 * sharp + 0.75 * 255.0 * m;
          }
          let mut q : f32 = 0.0;
          if value > 0.0 {
            q = value;
          }
          if q > 255.0 {
            q = 255.0;
          }
          pixel = pixel | (((q + 0.5) as u32) << ((8 * c) as u32));
        }
        out[oy][ox] = pixel;
      }
    }
  }
  return;
}

// `crop` is the window that `vxcam_smooth` keeps, or the whole frame.
pub fn vxcam_composite(out : &mut Tensor<u32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, blurred : &Tensor<f32, [?, ?], Memory::HBM>,
mask : &Tensor<f32, [?, ?], Memory::HBM>, crop : &Tensor<f32, [?, ?], Memory::HBM>, w : i32,
h : i32, scale : i32, mode : i32) -> void {
  let inv_scale : f32 = 1.0 / (scale as f32);
  composite_kernel(out, frame, blurred, mask, crop, inv_scale, w, h, w / scale, h / scale, mode);
  return;
}

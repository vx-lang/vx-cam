//===- vxcam.vx - The vx-cam frame pipeline ---------------------*- Vx -*-===//
//
// The compute stages of vx-cam: background blur with auto-framing. Every stage
// is a `pub fn`, so the host shell calls it through the C ABI (see vxcam.h).
// The host owns every buffer and passes each one as a tensor.
//
// Every stage is GPU kernels, and the serial end of smooth is host code. vxc
// also compiles a CPU copy of each kernel, and `vx_metal_set_enabled` picks one
// for the calling thread, so each stage runs on either device from one source.
// Until the segmentation model exists, `vxcam_segment` finds the person by
// background subtraction against a static background.
//
// Buffers:
//   frame   BGRA8, w x h pixels, `stride` bytes per row (from the camera or video)
//   small   RGB f32 in 0..1, sw x sh pixels, sw = w / scale and sh = h / scale
//   mask    f32 in 0..1, sw x sh, 1 where the person is
//   crop    [1, 4] f32 in host memory: x0, y0, width, height of the output window,
//           in frame pixels
//
//===----------------------------------------------------------------------===//

import core::convert;
import core::num;

//===----------------------------------------------------------------------===//
// Helpers. A function says where it runs. The scalar helpers say
// `on Topology::Any`: they run where they are called, so kernels and host code
// call the same ones. The samplers read GPU tensors, so they say
// `on Topology::Device`. vxc inlines a helper into the Metal code. Each also says
// what memory it touches, so the race checker of `across` loops need not read
// its body: `writes_only()` for none, `reads_only(t)` for reads of t.
//===----------------------------------------------------------------------===//

fn min_i32(a : i32, b : i32) on Topology::Any -> i32
ensures writes_only()
{
  let mut m = b;
  if a < b {
    m = a;
  }
  return m;
}

fn max_i32(a : i32, b : i32) on Topology::Any -> i32
ensures writes_only()
{
  let mut m = a;
  if b > a {
    m = b;
  }
  return m;
}

fn clamp_i32(v : i32, lo : i32, hi : i32) on Topology::Any -> i32
ensures writes_only()
{
  let mut x = v;
  if x < lo {
    x = lo;
  }
  if x > hi {
    x = hi;
  }
  return x;
}

fn max_f32(a : f32, b : f32) on Topology::Any -> f32
ensures writes_only()
{
  let mut m = b;
  if a > b {
    m = a;
  }
  return m;
}

// lo, or v if v is above lo; then hi if that is above hi.
fn clamp_f32(v : f32, lo : f32, hi : f32) on Topology::Any -> f32
ensures writes_only()
{
  let mut x = lo;
  if v > lo {
    x = v;
  }
  if x > hi {
    x = hi;
  }
  return x;
}

fn abs_f32(v : f32) on Topology::Any -> f32
ensures writes_only()
{
  let mut a = v;
  if v < 0.0 {
    a = 0.0 - v;
  }
  return a;
}

// 0 below `lo`, 1 above `hi`, and a smooth ramp between them.
fn smoothstep(lo : f32, hi : f32, v : f32) on Topology::Any -> f32
ensures writes_only()
{
  let t = clamp_f32((v - lo) / (hi - lo), 0.0, 1.0);
  return t * t * (3.0 - 2.0 * t);
}

// Bilinear mix of four neighbours: a and b on the top row, d and e below.
fn lerp2(a : f32, b : f32, d : f32, e : f32, fx : f32, fy : f32) on Topology::Any -> f32
ensures writes_only()
{
  let top = a + fx * (b - a);
  let bottom = d + fx * (e - d);
  return top + fy * (bottom - top);
}

// Bilinear sample of `t`: elements x0 and x1 of rows y0 and y1.
fn sample_u8(t : &Tensor<u8, [?, ?], Memory::HBM>, y0 : i32, y1 : i32, x0 : i32, x1 : i32,
fx : f32, fy : f32) on Topology::Device -> f32
ensures reads_only(t)
{
  return lerp2(f32::from(t[y0][x0]), f32::from(t[y0][x1]), f32::from(t[y1][x0]),
  f32::from(t[y1][x1]), fx, fy);
}

fn sample_f32(t : &Tensor<f32, [?, ?], Memory::HBM>, y0 : i32, y1 : i32, x0 : i32, x1 : i32,
fx : f32, fy : f32) on Topology::Device -> f32
ensures reads_only(t)
{
  return lerp2(t[y0][x0], t[y0][x1], t[y1][x0], t[y1][x1], fx, fy);
}

//===----------------------------------------------------------------------===//
// Stage 1: preprocess. Average each scale x scale block of the frame into one
// pixel of `small`, and convert BGRA8 to RGB f32.
//
// A GPU kernel, one lane per pixel of `small`. The frame is `[h, stride]` bytes:
// Vx needs a packed tensor from C, so the padding at the end of each row is part
// of the row.
//===----------------------------------------------------------------------===//

// `inv` is 1 / (scale * scale * 255).
fn preprocess_kernel(small : &mut Tensor<f32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, sw : i32, sh : i32, scale : i32,
inv : f32) -> void {
  spawn on(Topology::Device) {
    for sy in 0..sh across blocks {
      for sx in 0..sw across lanes(256) {
        let mut r : f32 = 0.0;
        let mut g : f32 = 0.0;
        let mut b : f32 = 0.0;
        for dy in 0..scale {
          let y = sy * scale + dy;
          for dx in 0..scale {
            let p = (sx * scale + dx) * 4;
            b = b + f32::from(frame[y][p]);
            g = g + f32::from(frame[y][p + 1]);
            r = r + f32::from(frame[y][p + 2]);
          }
        }
        small[sy][sx * 3] = r * inv;
        small[sy][sx * 3 + 1] = g * inv;
        small[sy][sx * 3 + 2] = b * inv;
      }
    }
  }
  return;
}

pub fn vxcam_preprocess(small : &mut Tensor<f32, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, sw : i32, sh : i32, scale : i32) -> void {
  let inv : f32 = 1.0 / ((scale * scale) as f32 * 255.0);
  preprocess_kernel(small, frame, sw, sh, scale, inv);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 2: segment. A stand-in for the segmentation model: a pixel belongs to
// the person when it differs from a running model of the background. The model
// learns only where the mask says "background", so a person who stands still
// is not absorbed at once. Frame 0 copies the background model from the frame.
//===----------------------------------------------------------------------===//

// A GPU kernel, one lane per pixel. `small` and `background` are `[sh, 3 * sw]`,
// `mask` is `[sh, sw]`. `first` is 1 on frame 0. The mask is
// smoothstep(0.06, 0.14, d), where d is the largest difference of the three
// channels from the background model.
fn segment_kernel(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
background : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, first : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let r = small[y][x * 3];
        let g = small[y][x * 3 + 1];
        let b = small[y][x * 3 + 2];
        let mut br = background[y][x * 3];
        let mut bg = background[y][x * 3 + 1];
        let mut bb = background[y][x * 3 + 2];
        if first == 1 {
          br = r;
          bg = g;
          bb = b;
        }
        let d = max_f32(abs_f32(r - br), max_f32(abs_f32(g - bg), abs_f32(b - bb)));
        let m = smoothstep(0.06, 0.14, d);
        mask[y][x] = m;
        let rate : f32 = 0.02 * (1.0 - m);
        background[y][x * 3] = br + rate * (r - br);
        background[y][x * 3 + 1] = bg + rate * (g - bg);
        background[y][x * 3 + 2] = bb + rate * (b - bb);
      }
    }
  }
  return;
}

pub fn vxcam_segment(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
background : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, frame_index : i32) -> void {
  let mut first : i32 = 0;
  if frame_index == 0 {
    first = 1;
  }
  segment_kernel(mask, background, small, sw, sh, first);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 2, the model: MediaPipe Selfie Segmentation, landscape (Google, Apache
// License 2.0; see models/README.md). A MobileNetV3-like network on a 144 x 256
// RGB image, which gives a 144 x 256 mask. Its 55 layers of weights are one
// tensor, in the order of the network, so each layer's weights start where the
// last one's end. Each layer is a conv kernel (OHWI, or 1HWC for a depthwise
// one) and then its bias.
//
// Every buffer is flat, [1, n], and holds an image as HWC. Each kernel has one
// lane per output element. A sigmoid needs exp, and the CPU and the GPU need
// not agree on its last bit, so `exp_f32` uses only + - * / and gives the same
// bits on both.
//===----------------------------------------------------------------------===//

// e^x for x in [-87, 87], to about 1e-7: e^x = 2^k e^r with |r| <= ln 2 / 2,
// e^r from its Taylor series, and 2^k from the bits of k.
fn exp_f32(x : f32) on Topology::Any -> f32
ensures writes_only()
{
  let v = clamp_f32(x, 0.0 - 87.0, 87.0);
  let t = v * 1.442695 + 0.5;
  let mut k = t as i32;
  if (k as f32) > t {
    k = k - 1;
  }
  let r = v - (k as f32) * 0.693145752 - (k as f32) * 0.0000014286068;
  let e = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666667 + r * (0.041666668 + r * (0.008333334
  + r * (0.0013888889 + r * 0.0001984127))))));
  let mut n = k;
  let mut base : f32 = 2.0;
  if k < 0 {
    n = 0 - k;
    base = 0.5;
  }
  let mut p : f32 = 1.0;
  for bit in 0..7 {
    if n - (n / 2) * 2 == 1 {
      p = p * base;
    }
    base = base * base;
    n = n / 2;
  }
  return e * p;
}

// The activations: 0 none, 1 relu, 2 hard swish, 3 sigmoid.
fn activate(v : f32, kind : i32) on Topology::Any -> f32
ensures writes_only()
{
  let mut out = v;
  if kind == 1 {
    out = max_f32(v, 0.0);
  }
  if kind == 2 {
    out = v * clamp_f32(v + 3.0, 0.0, 6.0) / 6.0;
  }
  if kind == 3 {
    out = 1.0 / (1.0 + exp_f32(0.0 - v));
  }
  return out;
}

// The model's input: `small` resampled to 144 x 256 RGB, with half-pixel centres.
fn model_input(inp : &mut Tensor<f32, [?, ?], Memory::HBM>,
small : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  let n : i32 = 144 * 256 * 3;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / 3;
          let c = i - p * 3;
          let y = p / 256;
          let x = p - y * 256;
          let sy = clamp_f32(((y as f32) + 0.5) * (sh as f32) / 144.0 - 0.5, 0.0, (sh - 1) as f32);
          let sx = clamp_f32(((x as f32) + 0.5) * (sw as f32) / 256.0 - 0.5, 0.0, (sw - 1) as f32);
          let y0 = sy as i32;
          let x0 = sx as i32;
          inp[0][i] = sample_f32(small, y0, min_i32(y0 + 1, sh - 1), x0 * 3 + c,
          min_i32(x0 + 1, sw - 1) * 3 + c, sx - x0 as f32, sy - y0 as f32);
        }
      }
    }
  }
  return;
}

// A k x k convolution with stride s and the padding of TFLite's SAME: `pt` and
// `pl` are the rows and columns of zeros before the image.
fn conv_kxk(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, cin : i32, oh : i32, ow : i32, cout : i32, k : i32, s : i32, pt : i32,
pl : i32, act : i32) -> void {
  let n = oh * ow * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let oy = p / ow;
          let ox = p - oy * ow;
          let mut acc = wts[0][off + cout * k * k * cin + co];
          for ky in 0..k {
            for kx in 0..k {
              let iy = oy * s + ky - pt;
              let ix = ox * s + kx - pl;
              if iy >= 0 && iy < h && ix >= 0 && ix < w {
                for ci in 0..cin {
                  acc = acc + wts[0][off + ((co * k + ky) * k + kx) * cin + ci]
                  * src[0][(iy * w + ix) * cin + ci];
                }
              }
            }
          }
          dst[0][i] = activate(acc, act);
        }
      }
    }
  }
  return;
}

// A 1 x 1 convolution over `npix` pixels. Its input is src, times gate[ci] when
// `use_gate` is 1, plus src2 when `use_src2` is 1. After the activation, it adds
// res when `use_res` is 1.
fn pw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
src2 : &Tensor<f32, [?, ?], Memory::HBM>, gate : &Tensor<f32, [?, ?], Memory::HBM>,
res : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
npix : i32, cin : i32, cout : i32, use_gate : i32, use_src2 : i32, use_res : i32,
act : i32) -> void {
  let n = npix * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let mut acc = wts[0][off + cout * cin + co];
          for ci in 0..cin {
            let mut v = src[0][p * cin + ci];
            if use_gate == 1 {
              v = v * gate[0][ci];
            }
            if use_src2 == 1 {
              v = v + src2[0][p * cin + ci];
            }
            acc = acc + wts[0][off + co * cin + ci] * v;
          }
          let mut out = activate(acc, act);
          if use_res == 1 {
            out = out + res[0][i];
          }
          dst[0][i] = out;
        }
      }
    }
  }
  return;
}

// A k x k depthwise convolution with stride s, SAME padding. After the
// activation, it adds its own input when `use_res` is 1 (stride 1 only).
fn dw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32, h : i32, w : i32, c : i32, oh : i32,
ow : i32, k : i32, s : i32, pt : i32, pl : i32, act : i32, use_res : i32) -> void {
  let n = oh * ow * c;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / c;
          let ch = i - p * c;
          let oy = p / ow;
          let ox = p - oy * ow;
          let mut acc = wts[0][off + k * k * c + ch];
          for ky in 0..k {
            for kx in 0..k {
              let iy = oy * s + ky - pt;
              let ix = ox * s + kx - pl;
              if iy >= 0 && iy < h && ix >= 0 && ix < w {
                acc = acc + wts[0][off + (ky * k + kx) * c + ch] * src[0][(iy * w + ix) * c + ch];
              }
            }
          }
          let mut out = activate(acc, act);
          if use_res == 1 {
            out = out + src[0][i];
          }
          dst[0][i] = out;
        }
      }
    }
  }
  return;
}

// means[c] = the mean over `npix` pixels of a, plus b when `use_b` is 1.
fn channel_mean(means : &mut Tensor<f32, [?, ?], Memory::HBM>,
a : &Tensor<f32, [?, ?], Memory::HBM>, b : &Tensor<f32, [?, ?], Memory::HBM>, npix : i32,
c : i32, use_b : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(c + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let ch = g * 256 + l;
        if ch < c {
          let mut acc : f32 = 0.0;
          for p in 0..npix {
            let mut v = a[0][p * c + ch];
            if use_b == 1 {
              v = v + b[0][p * c + ch];
            }
            acc = acc + v;
          }
          means[0][ch] = acc / (npix as f32);
        }
      }
    }
  }
  return;
}

// The squeeze-and-excite gate: gate = sigmoid(W2 relu(W1 means + b1) + b2),
// with c channels and m hidden ones. Each lane works out the hidden layer again,
// which costs m * c multiplies and saves a launch.
fn se_gate(gate : &mut Tensor<f32, [?, ?], Memory::HBM>,
means : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
c : i32, m : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(c + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let co = g * 256 + l;
        if co < c {
          let off2 = off + m * c + m;
          let mut acc = wts[0][off2 + c * m + co];
          for j in 0..m {
            let mut hj = wts[0][off + m * c + j];
            for ci in 0..c {
              hj = hj + wts[0][off + j * c + ci] * means[0][ci];
            }
            acc = acc + wts[0][off2 + co * m + j] * max_f32(hj, 0.0);
          }
          gate[0][co] = activate(acc, 3);
        }
      }
    }
  }
  return;
}

// A 1 x 1 convolution of src scaled up 2x (bilinear, half-pixel centres), each
// tap times gate[ci] when `use_gate` is 1. src is h x w, the output 2h x 2w.
fn up_pw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
gate : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, cin : i32, cout : i32, use_gate : i32) -> void {
  let n = 4 * h * w * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let oy = p / (2 * w);
          let ox = p - oy * (2 * w);
          let sy = (oy as f32) * 0.5 - 0.25;
          let sx = (ox as f32) * 0.5 - 0.25;
          let mut fy0 = sy as i32;
          if (fy0 as f32) > sy {
            fy0 = fy0 - 1;
          }
          let mut fx0 = sx as i32;
          if (fx0 as f32) > sx {
            fx0 = fx0 - 1;
          }
          let fy = sy - fy0 as f32;
          let fx = sx - fx0 as f32;
          let y0 = clamp_i32(fy0, 0, h - 1);
          let y1 = clamp_i32(fy0 + 1, 0, h - 1);
          let x0 = clamp_i32(fx0, 0, w - 1);
          let x1 = clamp_i32(fx0 + 1, 0, w - 1);
          let mut acc = wts[0][off + cout * cin + co];
          for ci in 0..cin {
            let mut gv : f32 = 1.0;
            if use_gate == 1 {
              gv = gate[0][ci];
            }
            let v = lerp2(src[0][(y0 * w + x0) * cin + ci] * gv, src[0][(y0 * w + x1) * cin + ci] * gv,
            src[0][(y1 * w + x0) * cin + ci] * gv, src[0][(y1 * w + x1) * cin + ci] * gv, fx, fy);
            acc = acc + wts[0][off + co * cin + ci] * v;
          }
          dst[0][i] = acc;
        }
      }
    }
  }
  return;
}

// The last layer: a 2 x 2 transposed convolution with stride 2 to one channel,
// then the sigmoid. src is h x w x c, the mask 2h x 2w.
fn out_tconv(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, c : i32) -> void {
  let n = 4 * h * w;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let oy = i / (2 * w);
          let ox = i - oy * (2 * w);
          let iy = oy / 2;
          let ix = ox / 2;
          let ky = oy - iy * 2;
          let kx = ox - ix * 2;
          let mut acc = wts[0][off + 4 * c];
          for ci in 0..c {
            acc = acc + src[0][(iy * w + ix) * c + ci] * wts[0][off + (ky * 2 + kx) * c + ci];
          }
          dst[0][i] = activate(acc, 3);
        }
      }
    }
  }
  return;
}

// mask = the model's 144 x 256 mask resampled to sh x sw.
fn mask_resample(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
mm : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let my = clamp_f32(((y as f32) + 0.5) * 144.0 / (sh as f32) - 0.5, 0.0, 143.0);
        let mx = clamp_f32(((x as f32) + 0.5) * 256.0 / (sw as f32) - 0.5, 0.0, 255.0);
        let y0 = my as i32;
        let x0 = mx as i32;
        let y1 = min_i32(y0 + 1, 143);
        let x1 = min_i32(x0 + 1, 255);
        mask[y][x] = lerp2(mm[0][y0 * 256 + x0], mm[0][y0 * 256 + x1], mm[0][y1 * 256 + x0],
        mm[0][y1 * 256 + x1], mx - x0 as f32, my - y0 as f32);
      }
    }
  }
  return;
}

// One block of the encoder, from x (h x w x cin) to out: expand to `mid`
// channels, a k x k depthwise conv with stride s, the squeeze-and-excite gate
// when `se` is not 0 (with `se` hidden channels), then project to cout, and add
// x when `use_res` is 1. Returns the offset of the next layer's weights.
fn encoder_block(out : &mut Tensor<f32, [?, ?], Memory::HBM>,
x : &Tensor<f32, [?, ?], Memory::HBM>, ta : &mut Tensor<f32, [?, ?], Memory::HBM>,
tb : &mut Tensor<f32, [?, ?], Memory::HBM>, means : &mut Tensor<f32, [?, ?], Memory::HBM>,
gate : &mut Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>,
off0 : i32, h : i32, w : i32, cin : i32, mid : i32, cout : i32, k : i32, s : i32, act : i32,
se : i32, use_res : i32) -> i32 {
  let mut off = off0;
  let oh = (h + s - 1) / s;
  let ow = (w + s - 1) / s;
  let pt = max_i32((oh - 1) * s + k - h, 0) / 2;
  let pl = max_i32((ow - 1) * s + k - w, 0) / 2;
  pw(ta, x, x, x, x, wts, off, h * w, cin, mid, 0, 0, 0, act);
  off = off + mid * cin + mid;
  dw(tb, ta, wts, off, h, w, mid, oh, ow, k, s, pt, pl, act, 0);
  off = off + k * k * mid + mid;
  let mut use_gate : i32 = 0;
  if se != 0 {
    channel_mean(means, tb, tb, oh * ow, mid, 0);
    se_gate(gate, means, wts, off, mid, se);
    off = off + se * mid + se + mid * se + mid;
    use_gate = 1;
  }
  pw(out, tb, tb, gate, x, wts, off, oh * ow, mid, cout, use_gate, 0, use_res, 0);
  return off + cout * mid + cout;
}

// One stage of the decoder, from x (h x w x cin) and the encoder's skip (2h x
// 2w x cout): U = a 1 x 1 conv of x scaled up 2x, then the gate of skip + U,
// V = skip * gate + U, P = relu(1 x 1 conv of V), and out = P + relu(depthwise
// 3 x 3 conv of P). Returns the offset of the next layer's weights.
fn decoder_stage(out : &mut Tensor<f32, [?, ?], Memory::HBM>,
x : &Tensor<f32, [?, ?], Memory::HBM>, skip : &Tensor<f32, [?, ?], Memory::HBM>,
tu : &mut Tensor<f32, [?, ?], Memory::HBM>, tp : &mut Tensor<f32, [?, ?], Memory::HBM>,
means : &mut Tensor<f32, [?, ?], Memory::HBM>, gate : &mut Tensor<f32, [?, ?], Memory::HBM>,
xgate : &Tensor<f32, [?, ?], Memory::HBM>, use_xgate : i32,
wts : &Tensor<f32, [?, ?], Memory::HBM>, off0 : i32, h : i32, w : i32, cin : i32,
cout : i32) -> i32 {
  let mut off = off0;
  let npix = 4 * h * w;
  up_pw(tu, x, xgate, wts, off, h, w, cin, cout, use_xgate);
  off = off + cout * cin + cout;
  channel_mean(means, skip, tu, npix, cout, 1);
  se_gate(gate, means, wts, off, cout, cout);
  off = off + 2 * (cout * cout + cout);
  pw(tp, skip, tu, gate, skip, wts, off, npix, cout, cout, 1, 1, 0, 1);
  off = off + cout * cout + cout;
  dw(out, tp, wts, off, 2 * h, 2 * w, cout, 2 * h, 2 * w, 3, 1, 1, 1, 1, 1);
  return off + 9 * cout + cout;
}

// The whole network, from `small` to `mask` (sh x sw). The shell passes slices
// of one arena for the rest: inp, the encoder's three skips s1 to s3, the work
// images ta to td, the model's own mask mm, and `means`, `gate` and `gate2`
// (128 each; gate2 is the gate of the head).
pub fn vxcam_model(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
small : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>,
inp : &mut Tensor<f32, [?, ?], Memory::HBM>, s1 : &mut Tensor<f32, [?, ?], Memory::HBM>,
s2 : &mut Tensor<f32, [?, ?], Memory::HBM>, s3 : &mut Tensor<f32, [?, ?], Memory::HBM>,
ta : &mut Tensor<f32, [?, ?], Memory::HBM>, tb : &mut Tensor<f32, [?, ?], Memory::HBM>,
tc : &mut Tensor<f32, [?, ?], Memory::HBM>, td : &mut Tensor<f32, [?, ?], Memory::HBM>,
mm : &mut Tensor<f32, [?, ?], Memory::HBM>, means : &mut Tensor<f32, [?, ?], Memory::HBM>,
gate : &mut Tensor<f32, [?, ?], Memory::HBM>, gate2 : &mut Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32) -> void {
  model_input(inp, small, sw, sh);
  // 144 x 256 x 3 -> 72 x 128 x 16
  conv_kxk(s1, inp, wts, 0, 144, 256, 3, 72, 128, 16, 3, 2, 0, 0, 2);
  let mut off : i32 = 16 * 9 * 3 + 16;
  // The encoder. Activation 1 is relu, 2 is hard swish.
  off = encoder_block(s2, s1, ta, tb, means, gate, wts, off, 72, 128, 16, 16, 16, 3, 2, 1, 8, 0);
  off = encoder_block(tc, s2, ta, tb, means, gate, wts, off, 36, 64, 16, 72, 24, 3, 2, 1, 0, 0);
  off = encoder_block(s3, tc, ta, tb, means, gate, wts, off, 18, 32, 24, 88, 24, 3, 1, 1, 0, 1);
  off = encoder_block(tc, s3, ta, tb, means, gate, wts, off, 18, 32, 24, 96, 32, 5, 2, 2, 24, 0);
  off = encoder_block(td, tc, ta, tb, means, gate, wts, off, 9, 16, 32, 128, 32, 5, 1, 2, 32, 1);
  off = encoder_block(tc, td, ta, tb, means, gate, wts, off, 9, 16, 32, 128, 32, 5, 1, 2, 32, 1);
  off = encoder_block(td, tc, ta, tb, means, gate, wts, off, 9, 16, 32, 96, 32, 5, 1, 2, 24, 1);
  off = encoder_block(tc, td, ta, tb, means, gate, wts, off, 9, 16, 32, 96, 32, 5, 1, 2, 24, 1);
  // The head: relu(1 x 1 conv) of the last block, gated by a sigmoid of its mean.
  channel_mean(means, tc, tc, 144, 32, 0);
  pw(ta, tc, tc, tc, tc, wts, off, 144, 32, 128, 0, 0, 0, 1);
  off = off + 128 * 32 + 128;
  pw(gate2, means, means, means, means, wts, off, 1, 32, 128, 0, 0, 0, 3);
  off = off + 128 * 32 + 128;
  // The decoder: 9 x 16 -> 18 x 32 -> 36 x 64 -> 72 x 128.
  off = decoder_stage(td, ta, s3, tb, tc, means, gate, gate2, 1, wts, off, 9, 16, 128, 24);
  off = decoder_stage(ta, td, s2, tb, tc, means, gate, gate2, 0, wts, off, 18, 32, 24, 16);
  off = decoder_stage(td, ta, s1, tb, tc, means, gate, gate2, 0, wts, off, 36, 64, 16, 16);
  out_tconv(mm, td, wts, off, 72, 128, 16);
  mask_resample(mask, mm, sw, sh);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 3: smooth. The branchy, stateful work that belongs on the CPU.
//   - Blend the new mask into the mask kept from earlier frames, so edges do
//     not flicker, then soften it with a small box filter.
//   - Find the person's bounding box and move the crop window toward a frame
//     around it. Small moves are ignored, so the window does not jitter.
// `history` and `crop` keep their values from one frame to the next. After the
// stage, `history` is the softened mask, and the guided filter below turns it
// into the `ab` that composite reads.
//
// Three GPU kernels, so the per-pixel part can move to the GPU like the other
// stages: the blend and the box filter along rows, the box filter along columns,
// and each row's part of the bounding box. Host code does the serial rest after
// a transfer of the row stats. Each image is `[sh, sw]`, and `stats` is `[sh, 3]`.
//===----------------------------------------------------------------------===//

// scratch = the box filter of radius 2 along each row of the blend of `mask`
// into `history`. On frame 0 (`first` is 1) the blend is the mask itself.
fn smooth_rows(scratch : &mut Tensor<f32, [?, ?], Memory::HBM>,
history : &Tensor<f32, [?, ?], Memory::HBM>, mask : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, first : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..5 {
          let xx = clamp_i32(x + d - 2, 0, sw - 1);
          let old = history[y][xx];
          let new = mask[y][xx];
          let mut blend = old + 0.5 * (new - old);
          if first == 1 {
            blend = new;
          }
          acc = acc + blend;
        }
        scratch[y][x] = acc / 5.0;
      }
    }
  }
  return;
}

// history = the box filter of radius 2 along each column of scratch.
fn smooth_cols(history : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..5 {
          acc = acc + scratch[clamp_i32(y + d - 2, 0, sh - 1)][x];
        }
        history[y][x] = acc / 5.0;
      }
    }
  }
  return;
}

// For each row y, one lane finds the first and the last x where the person is
// (history > 0.5) and how many such pixels there are: stats[y] = [first, last,
// count], or [sw, -1, 0] for a row without the person.
fn row_stats(stats : &mut Tensor<i32, [?, ?], Memory::HBM>,
history : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(sh + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let y = g * 256 + l;
        if y < sh {
          let mut lo = sw;
          let mut hi : i32 = 0 - 1;
          let mut n : i32 = 0;
          for x in 0..sw {
            if history[y][x] > 0.5 {
              if x < lo {
                lo = x;
              }
              hi = x;
              n = n + 1;
            }
          }
          stats[y][0] = lo;
          stats[y][1] = hi;
          stats[y][2] = n;
        }
      }
    }
  }
  return;
}

// The rest of the stage, on the host: reduce the rows to one bounding box, then
// move the crop window toward a frame around it. `stats` is in GPU memory, so
// the host reads it through a transfer. `crop` is `[1, 4]` in host memory.
fn frame_window(crop : &mut Tensor<f32, [?, ?], Memory::CPU_DRAM>,
stats : &Tensor<i32, [?, ?], Memory::HBM>, sw : i32, sh : i32, w : i32, h : i32,
first : i32) -> void {
  let s = transfer(stats, Memory::CPU_DRAM);
  // Bounding box of the person, from the rows.
  let mut min_x = sw;
  let mut min_y = sh;
  let mut max_x : i32 = 0 - 1;
  let mut max_y : i32 = 0 - 1;
  let mut count : i32 = 0;
  for y in 0..sh {
    let n = s[y][2];
    if n > 0 {
      if s[y][0] < min_x {
        min_x = s[y][0];
      }
      if s[y][1] > max_x {
        max_x = s[y][1];
      }
      if y < min_y {
        min_y = y;
      }
      max_y = y;
      count = count + n;
    }
  }

  // The window to move toward: the whole frame when nobody is there, or the
  // person's box with some room around it, at the frame's aspect ratio.
  let fw = w as f32;
  let fh = h as f32;
  let mut th = fh;
  let mut tx : f32 = 0.0;
  let mut ty : f32 = 0.0;
  if count * 500 > sw * sh {
    let sx = fw / (sw as f32);
    let sy = fh / (sh as f32);
    let bx0 = (min_x as f32) * sx;
    let by0 = (min_y as f32) * sy;
    let bw = ((max_x - min_x + 1) as f32) * sx;
    let bh = ((max_y - min_y + 1) as f32) * sy;
    // th = clamp(max(bh * 1.5, bw * 1.5 * fh / fw), fh * 0.45, fh)
    th = clamp_f32(max_f32(bh * 1.5, bw * 1.5 * fh / fw), fh * 0.45, fh);
    let tw = th * fw / fh;
    tx = clamp_f32(bx0 + bw * 0.5 - tw * 0.5, 0.0, fw - tw);
    ty = clamp_f32(by0 + bh * 0.4 - th * 0.4, 0.0, fh - th);
  }

  let mut c0 = crop[0][0];
  let mut c1 = crop[0][1];
  let mut c2 = crop[0][2];
  let mut c3 = crop[0][3];
  if first == 1 {
    c0 = 0.0;
    c1 = 0.0;
    c2 = fw;
    c3 = fh;
  }
  // Ignore moves under 3% of the frame. Otherwise ease toward the target.
  if abs_f32(tx - c0) + abs_f32(ty - c1) + abs_f32(th - c3) > 0.03 * fh {
    let k : f32 = 0.06;
    c0 = c0 + k * (tx - c0);
    c1 = c1 + k * (ty - c1);
    c3 = c3 + k * (th - c3);
    c2 = c3 * fw / fh;
  }
  crop[0][0] = c0;
  crop[0][1] = c1;
  crop[0][2] = c2;
  crop[0][3] = c3;
  return;
}

pub fn vxcam_smooth(history : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &mut Tensor<f32, [?, ?], Memory::HBM>, mask : &Tensor<f32, [?, ?], Memory::HBM>,
stats : &mut Tensor<i32, [?, ?], Memory::HBM>, crop : &mut Tensor<f32, [?, ?], Memory::CPU_DRAM>,
sw : i32, sh : i32, w : i32, h : i32, frame_index : i32) -> void {
  let mut first : i32 = 0;
  if frame_index == 0 {
    first = 1;
  }
  smooth_rows(scratch, history, mask, sw, sh, first);
  smooth_cols(history, scratch, sw, sh);
  row_stats(stats, history, sw, sh);
  frame_window(crop, stats, sw, sh, w, h, first);
  return;
}

//===----------------------------------------------------------------------===//
// The end of smooth: a guided filter (He, Sun and Tang, 2010) fits the mask to
// the edges of the image. In each window, the mask is close to a * I + b, where
// I is the gray of the image. smooth finds a and b at 1/4 size and keeps their
// mean over each window in `ab`. composite takes a * I + b with I from the sharp
// frame, so the edge of the mask follows the edges of the frame at full size
// (the fast guided filter, He and Sun, 2015).
//
// Four GPU kernels, each a box filter of radius `r` along the rows or the
// columns. `sums` and `means` are [sh, 4 * sw]: the means of I, p, I * p and
// I * I over a window, where p is the mask. `coefs` and `ab` are [sh, 2 * sw]:
// a and b.
//===----------------------------------------------------------------------===//

// The gray of an RGB pixel, the guide of the filter.
fn gray(r : f32, g : f32, b : f32) on Topology::Any -> f32
ensures writes_only()
{
  return 0.299 * r + 0.587 * g + 0.114 * b;
}

// sums = the means along each row of I, p, I * p and I * I.
fn guide_rows(sums : &mut Tensor<f32, [?, ?], Memory::HBM>,
small : &Tensor<f32, [?, ?], Memory::HBM>, mask : &Tensor<f32, [?, ?], Memory::HBM>,
sw : i32, sh : i32, r : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut si : f32 = 0.0;
        let mut sp : f32 = 0.0;
        let mut sip : f32 = 0.0;
        let mut sii : f32 = 0.0;
        for d in 0..2 * r + 1 {
          let xx = clamp_i32(x + d - r, 0, sw - 1);
          let i = gray(small[y][xx * 3], small[y][xx * 3 + 1], small[y][xx * 3 + 2]);
          let p = mask[y][xx];
          si = si + i;
          sp = sp + p;
          sip = sip + i * p;
          sii = sii + i * i;
        }
        let n = (2 * r + 1) as f32;
        sums[y][x * 4] = si / n;
        sums[y][x * 4 + 1] = sp / n;
        sums[y][x * 4 + 2] = sip / n;
        sums[y][x * 4 + 3] = sii / n;
      }
    }
  }
  return;
}

// dst = the mean along each column of src, over 2 * r + 1 rows.
fn box_cols(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, cols : i32, r : i32) -> void {
  spawn on(Topology::Device) {
    for i in 0..cols across blocks {
      for y in 0..rows across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..2 * r + 1 {
          acc = acc + src[clamp_i32(y + d - r, 0, rows - 1)][i];
        }
        dst[y][i] = acc / ((2 * r + 1) as f32);
      }
    }
  }
  return;
}

// coefs = the means along each row of a and b, where at each pixel
// a = (mean(I * p) - mean(I) * mean(p)) / (var(I) + eps) and b = mean(p) - a * mean(I).
fn coef_rows(coefs : &mut Tensor<f32, [?, ?], Memory::HBM>,
means : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32, r : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let mut sa : f32 = 0.0;
        let mut sb : f32 = 0.0;
        for d in 0..2 * r + 1 {
          let k = clamp_i32(x + d - r, 0, sw - 1) * 4;
          let mi = means[y][k];
          let mp = means[y][k + 1];
          let a = (means[y][k + 2] - mi * mp) / (means[y][k + 3] - mi * mi + eps);
          sa = sa + a;
          sb = sb + (mp - a * mi);
        }
        let n = (2 * r + 1) as f32;
        coefs[y][x * 2] = sa / n;
        coefs[y][x * 2 + 1] = sb / n;
      }
    }
  }
  return;
}

// A window of 9 x 9 small pixels (36 frame pixels across). A larger eps gives
// a smoother mask; a smaller one follows weaker edges.
pub fn vxcam_guide(ab : &mut Tensor<f32, [?, ?], Memory::HBM>,
sums : &mut Tensor<f32, [?, ?], Memory::HBM>, means : &mut Tensor<f32, [?, ?], Memory::HBM>,
coefs : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
history : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  let r : i32 = 4;
  let eps : f32 = 0.001;
  guide_rows(sums, small, history, sw, sh, r);
  box_cols(means, sums, sh, 4 * sw, r);
  coef_rows(coefs, means, sw, sh, r, eps);
  box_cols(ab, coefs, sh, 2 * sw, r);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 4: blur. A separable Gaussian blur of the small image: one pass along
// the rows, then one along the columns. The composite stage scales it up to the
// frame, so a sigma of r small pixels is a sigma of r * scale frame pixels.
//
// The passes are GPU kernels. `vx_metal_set_enabled(0)` runs the CPU copy of
// the same kernels on the same memory, so the CPU and the GPU run one source.
// The images are interleaved RGB: `rows` x `cols` floats, cols = 3 * width.
// The weights come from `vxcam_blur_weights`, once, so that `exp` runs on the
// CPU only and both devices read the same table.
//===----------------------------------------------------------------------===//

// The weights of a Gaussian with a sigma of `radius` small pixels, out to
// 3 * radius on each side, scaled to sum to 1. `weights` is [1, 6 * radius + 1].
pub fn vxcam_blur_weights(weights : &mut Tensor<f32, [?, ?], Memory::CPU_DRAM>,
radius : i32) -> void {
  let reach = 3 * radius;
  let sigma = radius as f32;
  let mut total : f32 = 0.0;
  for d in 0..2 * reach + 1 {
    let x = (d - reach) as f32;
    let e : f32 = 0.0 - x * x / (2.0 * sigma * sigma);
    let v = e.exp();
    weights[0][d] = v;
    total = total + v;
  }
  for d in 0..2 * reach + 1 {
    weights[0][d] = weights[0][d] / total;
  }
  return;
}

// One Gaussian pass along each row: element d of `weights` scales the pixel
// d - reach away, and the edge pixel stands in past the edge.
fn blur_rows(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, weights : &Tensor<f32, [?, ?], Memory::HBM>,
rows : i32, cols : i32, reach : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..rows across blocks {
      for i in 0..cols across lanes(256) {
        let x = i / 3;
        let c = i - x * 3;
        let last = cols / 3 - 1;
        let mut acc : f32 = 0.0;
        for d in 0..2 * reach + 1 {
          acc = acc + weights[0][d] * src[y][clamp_i32(x + d - reach, 0, last) * 3 + c];
        }
        dst[y][i] = acc;
      }
    }
  }
  return;
}

// The same pass along each column.
fn blur_cols(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, weights : &Tensor<f32, [?, ?], Memory::HBM>,
rows : i32, cols : i32, reach : i32) -> void {
  spawn on(Topology::Device) {
    for i in 0..cols across blocks {
      for y in 0..rows across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..2 * reach + 1 {
          acc = acc + weights[0][d] * src[clamp_i32(y + d - reach, 0, rows - 1)][i];
        }
        dst[y][i] = acc;
      }
    }
  }
  return;
}

pub fn vxcam_blur(blurred : &mut Tensor<f32, [?, ?], Memory::HBM>,
scratch : &mut Tensor<f32, [?, ?], Memory::HBM>, small : &Tensor<f32, [?, ?], Memory::HBM>,
weights : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, cols : i32, radius : i32) -> void {
  blur_rows(scratch, small, weights, rows, cols, 3 * radius);
  blur_cols(blurred, scratch, weights, rows, cols, 3 * radius);
  return;
}

//===----------------------------------------------------------------------===//
// Stage 5: composite. For each output pixel, find where it comes from inside the
// crop window, then mix the sharp frame and the blurred background by the mask.
// `mode` 0 is the normal output, 1 shows the mask, 2 turns the blur off. 3 to 5
// are the same with a green outline where the mask crosses 0.5.
//
// A GPU kernel, one lane per output pixel. `frame` is `[h, stride]` bytes as in
// preprocess, `out` is `[h, 4 * w]` BGRA bytes, `blurred` is `[sh, 3 * sw]` and
// `ab` is `[sh, 2 * sw]`, the guided filter's a and b from smooth. The mask at a
// pixel is a * I + b, where I is the gray of the sharp frame there.
//===----------------------------------------------------------------------===//

// The mask at output pixel (ox, oy), as composite_kernel computes it: a * I + b
// where the pixel comes from.
fn mask_at(frame : &Tensor<u8, [?, ?], Memory::HBM>, ab : &Tensor<f32, [?, ?], Memory::HBM>,
x0 : f32, y0 : f32, kx : f32, ky : f32, inv_scale : f32, w : i32, h : i32, sw : i32, sh : i32,
ox : i32, oy : i32) on Topology::Device -> f32
ensures reads_only(frame)
ensures reads_only(ab)
{
  let sy = clamp_f32(y0 + ((oy as f32) + 0.5) * ky - 0.5, 0.0, (h - 1) as f32);
  let iy0 = sy as i32;
  let iy1 = min_i32(iy0 + 1, h - 1);
  let fy = sy - iy0 as f32;
  let v = clamp_f32((sy + 0.5) * inv_scale - 0.5, 0.0, (sh - 1) as f32);
  let vy0 = v as i32;
  let vy1 = min_i32(vy0 + 1, sh - 1);
  let gy = v - vy0 as f32;
  let sx = clamp_f32(x0 + ((ox as f32) + 0.5) * kx - 0.5, 0.0, (w - 1) as f32);
  let ix0 = sx as i32;
  let ix1 = min_i32(ix0 + 1, w - 1);
  let fx = sx - ix0 as f32;
  let u = clamp_f32((sx + 0.5) * inv_scale - 0.5, 0.0, (sw - 1) as f32);
  let ux0 = u as i32;
  let ux1 = min_i32(ux0 + 1, sw - 1);
  let gx = u - ux0 as f32;
  let sb = sample_u8(frame, iy0, iy1, ix0 * 4, ix1 * 4, fx, fy);
  let sg = sample_u8(frame, iy0, iy1, ix0 * 4 + 1, ix1 * 4 + 1, fx, fy);
  let sr = sample_u8(frame, iy0, iy1, ix0 * 4 + 2, ix1 * 4 + 2, fx, fy);
  let a = sample_f32(ab, vy0, vy1, ux0 * 2, ux1 * 2, gx, gy);
  let b = sample_f32(ab, vy0, vy1, ux0 * 2 + 1, ux1 * 2 + 1, gx, gy);
  return clamp_f32(a * gray(sr, sg, sb) / 255.0 + b, 0.0, 1.0);
}

// The window's corner is (x0, y0) in frame pixels, and kx, ky scale output
// pixels to frame pixels. `inv_scale` is 1 / scale, from frame pixels to small
// pixels.
fn composite_kernel(out : &mut Tensor<u8, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, blurred : &Tensor<f32, [?, ?], Memory::HBM>,
ab : &Tensor<f32, [?, ?], Memory::HBM>, x0 : f32, y0 : f32, kx : f32, ky : f32,
inv_scale : f32, w : i32, h : i32, sw : i32, sh : i32, mode : i32) -> void {
  spawn on(Topology::Device) {
    for oy in 0..h across blocks {
      for ox in 0..w across lanes(256) {
        // Where this pixel comes from: sy, sx in the frame, v, u in the small images.
        let sy = clamp_f32(y0 + ((oy as f32) + 0.5) * ky - 0.5, 0.0, (h - 1) as f32);
        let iy0 = sy as i32;
        let iy1 = min_i32(iy0 + 1, h - 1);
        let fy = sy - iy0 as f32;
        let v = clamp_f32((sy + 0.5) * inv_scale - 0.5, 0.0, (sh - 1) as f32);
        let vy0 = v as i32;
        let vy1 = min_i32(vy0 + 1, sh - 1);
        let gy = v - vy0 as f32;
        let sx = clamp_f32(x0 + ((ox as f32) + 0.5) * kx - 0.5, 0.0, (w - 1) as f32);
        let ix0 = sx as i32;
        let ix1 = min_i32(ix0 + 1, w - 1);
        let fx = sx - ix0 as f32;
        let u = clamp_f32((sx + 0.5) * inv_scale - 0.5, 0.0, (sw - 1) as f32);
        let ux0 = u as i32;
        let ux1 = min_i32(ux0 + 1, sw - 1);
        let gx = u - ux0 as f32;
        // BGRA in the frame and in `out`, RGB in `blurred`.
        let sb = sample_u8(frame, iy0, iy1, ix0 * 4, ix1 * 4, fx, fy);
        let sg = sample_u8(frame, iy0, iy1, ix0 * 4 + 1, ix1 * 4 + 1, fx, fy);
        let sr = sample_u8(frame, iy0, iy1, ix0 * 4 + 2, ix1 * 4 + 2, fx, fy);
        let a = sample_f32(ab, vy0, vy1, ux0 * 2, ux1 * 2, gx, gy);
        let b = sample_f32(ab, vy0, vy1, ux0 * 2 + 1, ux1 * 2 + 1, gx, gy);
        let m = clamp_f32(a * gray(sr, sg, sb) / 255.0 + b, 0.0, 1.0);
        // The outline: a pixel whose neighbour one pixel away is on the other side of
        // m = 0.5. The line is two pixels wide.
        let mut view = mode;
        let mut edge = 0;
        if mode >= 3 {
          view = mode - 3;
          for k in 0..4 {
            let mut nx = ox;
            let mut ny = oy;
            if k == 0 {
              nx = min_i32(ox + 1, w - 1);
            }
            if k == 1 {
              nx = max_i32(ox - 1, 0);
            }
            if k == 2 {
              ny = min_i32(oy + 1, h - 1);
            }
            if k == 3 {
              ny = max_i32(oy - 1, 0);
            }
            let n = mask_at(frame, ab, x0, y0, kx, ky, inv_scale, w, h, sw, sh, nx, ny);
            if (n >= 0.5) != (m >= 0.5) {
              edge = 1;
            }
          }
        }
        for c in 0..3 {
          let mut sharp = sb;
          if c == 1 {
            sharp = sg;
          }
          if c == 2 {
            sharp = sr;
          }
          let k = 2 - c;
          let soft = 255.0 * sample_f32(blurred, vy0, vy1, ux0 * 3 + k, ux1 * 3 + k, gx, gy);
          let mut value = sharp;
          if view == 0 {
            value = soft + m * (sharp - soft);
          }
          if view == 1 {
            value = 0.25 * sharp + 0.75 * 255.0 * m;
          }
          if edge == 1 {
            // Green, BGR.
            value = 80.0;
            if c == 1 {
              value = 255.0;
            }
          }
          out[oy][ox * 4 + c] = (clamp_f32(value, 0.0, 255.0) + 0.5) as u8;
        }
        out[oy][ox * 4 + 3] = 255;
      }
    }
  }
  return;
}

// `crop` is the window that `vxcam_smooth` keeps, or the whole frame, in host
// memory.
pub fn vxcam_composite(out : &mut Tensor<u8, [?, ?], Memory::HBM>,
frame : &Tensor<u8, [?, ?], Memory::HBM>, blurred : &Tensor<f32, [?, ?], Memory::HBM>,
ab : &Tensor<f32, [?, ?], Memory::HBM>, crop : &Tensor<f32, [?, ?], Memory::CPU_DRAM>,
w : i32, h : i32, scale : i32, mode : i32) -> void {
  let inv_scale : f32 = 1.0 / (scale as f32);
  let kx = crop[0][2] / (w as f32);
  let ky = crop[0][3] / (h as f32);
  composite_kernel(out, frame, blurred, ab, crop[0][0], crop[0][1], kx, ky, inv_scale, w, h,
  w / scale, h / scale, mode);
  return;
}

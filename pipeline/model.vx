//===- model.vx - The segmentation model of vx-cam ---------------*- Vx -*-===//
//
// MediaPipe Selfie Segmentation, landscape (Google, Apache License 2.0; see
// models/README.md). A MobileNetV3-like network on a 144 x 256 RGB image, which
// gives a 144 x 256 mask. Its 55 layers of weights are one tensor, in the order
// of the network, so each layer's weights start where the last one's end. Each
// layer is a conv kernel (OHWI, or 1HWC for a depthwise one) and then its bias.
//
// Every buffer is flat, [1, n], and holds an image as HWC. Most kernels have one
// lane per output element. A sigmoid needs exp, and the CPU and the GPU need
// not agree on its last bit, so `exp_f32` uses only + - * / and gives the same
// bits on both. Every kernel gives the same bits on both devices, except
// `pw_tiles` (VXCAM_MODEL=tiles in the shell).
//
// This file holds the layers. `vxcam_model` in vxcam.vx chains them into the
// network: vxc exports only the `pub fn`s of the file it compiles.
//
//===----------------------------------------------------------------------===//

import core::convert;
import common;

// e^x for x in [-87, 87], to about 1e-7: e^x = 2^k e^r with |r| <= ln 2 / 2,
// e^r from its Taylor series, and 2^k from the bits of k.
fn exp_f32(x : f32) on Topology::Any -> f32
ensures writes_only()
{
  let v = clamp_f32(x, 0.0 - 87.0, 87.0);
  let t = v * 1.442695 + 0.5;
  let mut k = t as i32;
  if (k as f32) > t {
    k = k - 1;
  }
  let r = v - (k as f32) * 0.693145752 - (k as f32) * 0.0000014286068;
  let e = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666667 + r * (0.041666668 + r * (0.008333334
  + r * (0.0013888889 + r * 0.0001984127))))));
  let mut n = k;
  let mut base : f32 = 2.0;
  if k < 0 {
    n = 0 - k;
    base = 0.5;
  }
  let mut p : f32 = 1.0;
  for bit in 0..7 {
    if n - (n / 2) * 2 == 1 {
      p = p * base;
    }
    base = base * base;
    n = n / 2;
  }
  return e * p;
}

// The activations: 0 none, 1 relu, 2 hard swish, 3 sigmoid.
fn activate(v : f32, kind : i32) on Topology::Any -> f32
ensures writes_only()
{
  let mut out = v;
  if kind == 1 {
    out = max_f32(v, 0.0);
  }
  if kind == 2 {
    out = v * clamp_f32(v + 3.0, 0.0, 6.0) / 6.0;
  }
  if kind == 3 {
    out = 1.0 / (1.0 + exp_f32(0.0 - v));
  }
  return out;
}

// The model's input: `small` resampled to 144 x 256 RGB, with half-pixel centres.
fn model_input(inp : &mut Tensor<f32, [?, ?], Memory::HBM>,
small : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  let n : i32 = 144 * 256 * 3;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / 3;
          let c = i - p * 3;
          let y = p / 256;
          let x = p - y * 256;
          let sy = clamp_f32(((y as f32) + 0.5) * (sh as f32) / 144.0 - 0.5, 0.0, (sh - 1) as f32);
          let sx = clamp_f32(((x as f32) + 0.5) * (sw as f32) / 256.0 - 0.5, 0.0, (sw - 1) as f32);
          inp[0][i] = bilinear_f32(small, sx, sy, sw, sh, 3, c);
        }
      }
    }
  }
  return;
}

// A k x k convolution with stride s and the padding of TFLite's SAME: `pt` and
// `pl` are the rows and columns of zeros before the image.
fn conv_kxk(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, cin : i32, oh : i32, ow : i32, cout : i32, k : i32, s : i32, pt : i32,
pl : i32, act : i32) -> void {
  let n = oh * ow * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let oy = p / ow;
          let ox = p - oy * ow;
          let mut acc = wts[0][off + cout * k * k * cin + co];
          for ky in 0..k {
            for kx in 0..k {
              let iy = oy * s + ky - pt;
              let ix = ox * s + kx - pl;
              if iy >= 0 && iy < h && ix >= 0 && ix < w {
                for ci in 0..cin {
                  acc = acc + wts[0][off + ((co * k + ky) * k + kx) * cin + ci]
                  * src[0][(iy * w + ix) * cin + ci];
                }
              }
            }
          }
          dst[0][i] = activate(acc, act);
        }
      }
    }
  }
  return;
}

// A 1 x 1 convolution over `npix` pixels. Its input is src, times gate[ci] when
// `use_gate` is 1, plus src2 when `use_src2` is 1. After the activation, it adds
// res when `use_res` is 1.
fn pw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
src2 : &Tensor<f32, [?, ?], Memory::HBM>, gate : &Tensor<f32, [?, ?], Memory::HBM>,
res : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
npix : i32, cin : i32, cout : i32, use_gate : i32, use_src2 : i32, use_res : i32,
act : i32) -> void {
  let n = npix * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let mut acc = wts[0][off + cout * cin + co];
          for ci in 0..cin {
            let mut v = src[0][p * cin + ci];
            if use_gate == 1 {
              v = v * gate[0][ci];
            }
            if use_src2 == 1 {
              v = v + src2[0][p * cin + ci];
            }
            acc = acc + wts[0][off + co * cin + ci] * v;
          }
          let mut out = activate(acc, act);
          if use_res == 1 {
            out = out + res[0][i];
          }
          dst[0][i] = out;
        }
      }
    }
  }
  return;
}

// pw with matmuls of tiles, which the Apple GPU runs on its simdgroup matrices.
// Each subgroup makes 8 pixels by 8 output channels, and adds 8 input channels
// at a time. A block has two subgroups, so npix is a multiple of 16. The channel
// counts are numbers, and NCT is COUT / 8, so that the compiler can prove that
// no two blocks write the same element of dst. Lane i takes row h * 4 + i / 8
// and column i % 8 of a tile, for h in 0 and 1.
fn pw_tiles<const CIN : i32, const COUT : i32, const NCT : i32>(
dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
src2 : &Tensor<f32, [?, ?], Memory::HBM>, gate : &Tensor<f32, [?, ?], Memory::HBM>,
res : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
npix : i32, use_gate : i32, use_src2 : i32, use_res : i32, act : i32) -> void {
  spawn on(Topology::Device) {
    for gp in 0..npix / 16 across blocks {
      for ct in 0..NCT across blocks {
        let mut sa = unsafe { Tensor<f32, [2, 8, 8], Memory::SMEM>::uninit() };
        let mut sb = unsafe { Tensor<f32, [2, 8, 8], Memory::SMEM>::uninit() };
        let mut acc = unsafe {
          Tensor<f32, [2, 8, 8], Memory::SMEM>::uninit()
        };
        for w in 0..2 across subgroups {
          let pt = gp * 2 + w;
          for i in 0..32 across lanes {
            for h in 0..2 {
              acc[w][h * 4 + i / 8][i % 8] = 0.0;
            }
          }
          for kk in 0..CIN / 8 {
            for i in 0..32 across lanes {
              for h in 0..2 {
                let r = h * 4 + i / 8;
                let c = i % 8;
                let p = pt * 8 + r;
                let ci = kk * 8 + c;
                let mut v = src[0][p * CIN + ci];
                if use_gate == 1 {
                  v = v * gate[0][ci];
                }
                if use_src2 == 1 {
                  v = v + src2[0][p * CIN + ci];
                }
                sa[w][r][c] = v;
                sb[w][r][c] = wts[0][off + (ct * 8 + c) * CIN + kk * 8 + r];
              }
            }
            acc[w] = acc[w] + sa[w] @ sb[w];
          }
          for i in 0..32 across lanes {
            for h in 0..2 {
              let r = h * 4 + i / 8;
              let c = i % 8;
              let p = pt * 8 + r;
              let co = ct * 8 + c;
              let mut out = activate(acc[w][r][c] + wts[0][off + COUT * CIN + co], act);
              if use_res == 1 {
                out = out + res[0][p * COUT + co];
              }
              dst[0][p * COUT + co] = out;
            }
          }
        }
      }
    }
  }
  return;
}

// A k x k depthwise convolution with stride s, SAME padding. After the
// activation, it adds its own input when `use_res` is 1 (stride 1 only).
fn dw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32, h : i32, w : i32, c : i32, oh : i32,
ow : i32, k : i32, s : i32, pt : i32, pl : i32, act : i32, use_res : i32) -> void {
  let n = oh * ow * c;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / c;
          let ch = i - p * c;
          let oy = p / ow;
          let ox = p - oy * ow;
          let mut acc = wts[0][off + k * k * c + ch];
          for ky in 0..k {
            for kx in 0..k {
              let iy = oy * s + ky - pt;
              let ix = ox * s + kx - pl;
              if iy >= 0 && iy < h && ix >= 0 && ix < w {
                acc = acc + wts[0][off + (ky * k + kx) * c + ch] * src[0][(iy * w + ix) * c + ch];
              }
            }
          }
          let mut out = activate(acc, act);
          if use_res == 1 {
            out = out + src[0][i];
          }
          dst[0][i] = out;
        }
      }
    }
  }
  return;
}

// The pixels of the image in runs of 64: parts[q * c + ch] is the sum of
// channel ch over run q, of a plus b when `use_b` is 1. One lane for each run
// and channel, so that the sums spread over the GPU.
fn channel_sums(parts : &mut Tensor<f32, [?, ?], Memory::HBM>,
a : &Tensor<f32, [?, ?], Memory::HBM>, b : &Tensor<f32, [?, ?], Memory::HBM>, npix : i32,
c : i32, use_b : i32) -> void {
  let n = (npix + 63) / 64 * c;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let q = i / c;
          let ch = i - q * c;
          let mut acc : f32 = 0.0;
          for k in 0..64 {
            let p = q * 64 + k;
            if p < npix {
              let mut v = a[0][p * c + ch];
              if use_b == 1 {
                v = v + b[0][p * c + ch];
              }
              acc = acc + v;
            }
          }
          parts[0][i] = acc;
        }
      }
    }
  }
  return;
}

// The squeeze-and-excite gate: gate = sigmoid(W2 relu(W1 means + b1) + b2),
// with c channels (at most 128) and m hidden ones, where `means` are the means
// over `npix` pixels from the sums of `channel_sums`. One block, in three steps.
fn se_gate(gate : &mut Tensor<f32, [?, ?], Memory::HBM>,
parts : &Tensor<f32, [?, ?], Memory::HBM>, npix : i32, wts : &Tensor<f32, [?, ?], Memory::HBM>,
off : i32, c : i32, m : i32) -> void {
  assert(c <= 128 && m <= 128, "se_gate takes at most 128 channels");
  let runs = (npix + 63) / 64;
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      let mut means = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      let mut hidden = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      for l in 0..128 across lanes(128) {
        if l < c {
          let mut acc : f32 = 0.0;
          for q in 0..runs {
            acc = acc + parts[0][q * c + l];
          }
          means[l] = acc / (npix as f32);
        }
      }
      for l in 0..128 across lanes(128) {
        if l < m {
          let mut h = wts[0][off + m * c + l];
          for ci in 0..c {
            h = h + wts[0][off + l * c + ci] * means[ci];
          }
          hidden[l] = max_f32(h, 0.0);
        }
      }
      for l in 0..128 across lanes(128) {
        if l < c {
          let off2 = off + m * c + m;
          let mut acc = wts[0][off2 + c * m + l];
          for j in 0..m {
            acc = acc + wts[0][off2 + l * m + j] * hidden[j];
          }
          gate[0][l] = activate(acc, 3);
        }
      }
    }
  }
  return;
}

// The gate of the head: gate = sigmoid(W means + b), from c channels (at most
// 128) to 128, where `means` come from the sums of `channel_sums` as in se_gate.
fn head_gate(gate : &mut Tensor<f32, [?, ?], Memory::HBM>,
parts : &Tensor<f32, [?, ?], Memory::HBM>, npix : i32, wts : &Tensor<f32, [?, ?], Memory::HBM>,
off : i32, c : i32) -> void {
  assert(c <= 128, "head_gate takes at most 128 channels");
  let runs = (npix + 63) / 64;
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      let mut means = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      for l in 0..128 across lanes(128) {
        if l < c {
          let mut acc : f32 = 0.0;
          for q in 0..runs {
            acc = acc + parts[0][q * c + l];
          }
          means[l] = acc / (npix as f32);
        }
      }
      for l in 0..128 across lanes(128) {
        let mut acc = wts[0][off + 128 * c + l];
        for ci in 0..c {
          acc = acc + wts[0][off + l * c + ci] * means[ci];
        }
        gate[0][l] = activate(acc, 3);
      }
    }
  }
  return;
}

// A 1 x 1 convolution of src scaled up 2x (bilinear, half-pixel centres), each
// tap times gate[ci] when `use_gate` is 1. src is h x w, the output 2h x 2w.
fn up_pw(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>,
gate : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, cin : i32, cout : i32, use_gate : i32) -> void {
  let n = 4 * h * w * cout;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let p = i / cout;
          let co = i - p * cout;
          let oy = p / (2 * w);
          let ox = p - oy * (2 * w);
          let sy = (oy as f32) * 0.5 - 0.25;
          let sx = (ox as f32) * 0.5 - 0.25;
          let mut fy0 = sy as i32;
          if (fy0 as f32) > sy {
            fy0 = fy0 - 1;
          }
          let mut fx0 = sx as i32;
          if (fx0 as f32) > sx {
            fx0 = fx0 - 1;
          }
          let fy = sy - fy0 as f32;
          let fx = sx - fx0 as f32;
          let y0 = clamp_i32(fy0, 0, h - 1);
          let y1 = clamp_i32(fy0 + 1, 0, h - 1);
          let x0 = clamp_i32(fx0, 0, w - 1);
          let x1 = clamp_i32(fx0 + 1, 0, w - 1);
          let mut acc = wts[0][off + cout * cin + co];
          for ci in 0..cin {
            let mut gv : f32 = 1.0;
            if use_gate == 1 {
              gv = gate[0][ci];
            }
            let v = lerp2(src[0][(y0 * w + x0) * cin + ci] * gv, src[0][(y0 * w + x1) * cin + ci] * gv,
            src[0][(y1 * w + x0) * cin + ci] * gv, src[0][(y1 * w + x1) * cin + ci] * gv, fx, fy);
            acc = acc + wts[0][off + co * cin + ci] * v;
          }
          dst[0][i] = acc;
        }
      }
    }
  }
  return;
}

// The last layer: a 2 x 2 transposed convolution with stride 2 to one channel,
// then the sigmoid. src is h x w x c, the mask 2h x 2w.
fn out_tconv(dst : &mut Tensor<f32, [?, ?], Memory::HBM>,
src : &Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>, off : i32,
h : i32, w : i32, c : i32) -> void {
  let n = 4 * h * w;
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          let oy = i / (2 * w);
          let ox = i - oy * (2 * w);
          let iy = oy / 2;
          let ix = ox / 2;
          let ky = oy - iy * 2;
          let kx = ox - ix * 2;
          let mut acc = wts[0][off + 4 * c];
          for ci in 0..c {
            acc = acc + src[0][(iy * w + ix) * c + ci] * wts[0][off + (ky * 2 + kx) * c + ci];
          }
          dst[0][i] = activate(acc, 3);
        }
      }
    }
  }
  return;
}

// mask = the model's 144 x 256 mask resampled to sh x sw.
fn mask_resample(mask : &mut Tensor<f32, [?, ?], Memory::HBM>,
mm : &Tensor<f32, [?, ?], Memory::HBM>, sw : i32, sh : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..sh across blocks {
      for x in 0..sw across lanes(256) {
        let my = clamp_f32(((y as f32) + 0.5) * 144.0 / (sh as f32) - 0.5, 0.0, 143.0);
        let mx = clamp_f32(((x as f32) + 0.5) * 256.0 / (sw as f32) - 0.5, 0.0, 255.0);
        let y0 = my as i32;
        let x0 = mx as i32;
        let y1 = min_i32(y0 + 1, 143);
        let x1 = min_i32(x0 + 1, 255);
        mask[y][x] = lerp2(mm[0][y0 * 256 + x0], mm[0][y0 * 256 + x1], mm[0][y1 * 256 + x0],
        mm[0][y1 * 256 + x1], mx - x0 as f32, my - y0 as f32);
      }
    }
  }
  return;
}

// One block of the encoder, from x (h x w x cin) to out: expand to `mid`
// channels, a k x k depthwise conv with stride s, the squeeze-and-excite gate
// when `se` is not 0 (with `se` hidden channels), then project to cout, and add
// x when `use_res` is 1. Returns the offset of the next layer's weights.
fn encoder_block<const CIN : i32, const MID : i32, const COUT : i32>(out : &mut Tensor<f32, [?, ?], Memory::HBM>,
x : &Tensor<f32, [?, ?], Memory::HBM>, ta : &mut Tensor<f32, [?, ?], Memory::HBM>,
tb : &mut Tensor<f32, [?, ?], Memory::HBM>, parts : &mut Tensor<f32, [?, ?], Memory::HBM>,
gate : &mut Tensor<f32, [?, ?], Memory::HBM>, wts : &Tensor<f32, [?, ?], Memory::HBM>,
off0 : i32, h : i32, w : i32, k : i32, s : i32, act : i32, se : i32, use_res : i32,
tiles : i32) -> i32 {
  let cin = CIN;
  let mid = MID;
  let cout = COUT;
  let mut off = off0;
  let oh = (h + s - 1) / s;
  let ow = (w + s - 1) / s;
  let pt = max_i32((oh - 1) * s + k - h, 0) / 2;
  let pl = max_i32((ow - 1) * s + k - w, 0) / 2;
  if tiles == 1 {
    pw_tiles<CIN, MID, MID / 8>(ta, x, x, x, x, wts, off, h * w, 0, 0, 0, act);
  } else {
    pw(ta, x, x, x, x, wts, off, h * w, cin, mid, 0, 0, 0, act);
  }
  off = off + mid * cin + mid;
  dw(tb, ta, wts, off, h, w, mid, oh, ow, k, s, pt, pl, act, 0);
  off = off + k * k * mid + mid;
  let mut use_gate : i32 = 0;
  if se != 0 {
    channel_sums(parts, tb, tb, oh * ow, mid, 0);
    se_gate(gate, parts, oh * ow, wts, off, mid, se);
    off = off + se * mid + se + mid * se + mid;
    use_gate = 1;
  }
  if tiles == 1 {
    pw_tiles<MID, COUT, COUT / 8>(out, tb, tb, gate, x, wts, off, oh * ow, use_gate, 0, use_res, 0);
  } else {
    pw(out, tb, tb, gate, x, wts, off, oh * ow, mid, cout, use_gate, 0, use_res, 0);
  }
  return off + cout * mid + cout;
}

// One stage of the decoder, from x (h x w x cin) and the encoder's skip (2h x
// 2w x cout): U = a 1 x 1 conv of x scaled up 2x, then the gate of skip + U,
// V = skip * gate + U, P = relu(1 x 1 conv of V), and out = P + relu(depthwise
// 3 x 3 conv of P). Returns the offset of the next layer's weights.
fn decoder_stage<const COUT : i32>(out : &mut Tensor<f32, [?, ?], Memory::HBM>,
x : &Tensor<f32, [?, ?], Memory::HBM>, skip : &Tensor<f32, [?, ?], Memory::HBM>,
tu : &mut Tensor<f32, [?, ?], Memory::HBM>, tp : &mut Tensor<f32, [?, ?], Memory::HBM>,
parts : &mut Tensor<f32, [?, ?], Memory::HBM>, gate : &mut Tensor<f32, [?, ?], Memory::HBM>,
xgate : &Tensor<f32, [?, ?], Memory::HBM>, use_xgate : i32,
wts : &Tensor<f32, [?, ?], Memory::HBM>, off0 : i32, h : i32, w : i32, cin : i32,
tiles : i32) -> i32 {
  let cout = COUT;
  let mut off = off0;
  let npix = 4 * h * w;
  up_pw(tu, x, xgate, wts, off, h, w, cin, cout, use_xgate);
  off = off + cout * cin + cout;
  channel_sums(parts, skip, tu, npix, cout, 1);
  se_gate(gate, parts, npix, wts, off, cout, cout);
  off = off + 2 * (cout * cout + cout);
  if tiles == 1 {
    pw_tiles<COUT, COUT, COUT / 8>(tp, skip, tu, gate, skip, wts, off, npix, 1, 1, 0, 1);
  } else {
    pw(tp, skip, tu, gate, skip, wts, off, npix, cout, cout, 1, 1, 0, 1);
  }
  off = off + cout * cout + cout;
  dw(out, tp, wts, off, 2 * h, 2 * w, cout, 2 * h, 2 * w, 3, 1, 1, 1, 1, 1);
  return off + 9 * cout + cout;
}
